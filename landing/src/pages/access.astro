---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteLabel = import.meta.env.APP_ORIGIN || "http://localhost:4321";
---

<BaseLayout title="Iniciar sesión">
  <div id="wrapper" class="access-wrapper">
    <div id="bg"></div>
    <div id="overlay" class="access-overlay"></div>

    <div id="main" class="access-main">
      <section class="access-card card-enter">
        <h1>Solicitar acceso</h1>
        <p class="access-url">{siteLabel}</p>

        <form id="access-form">
          <div class="field">
            <label for="email">Correo del reclutador o RRHH</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="nombre@empresa.com"
              required
            />
          </div>

          <div class="field">
            <label for="company">Empresa o referencia</label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder="Nombre de empresa"
            />
          </div>

          <p class="access-note">
            Se enviará un enlace temporal de un solo uso.
            <span class="access-note-nowrap">
              El sistema registra IP, navegador, fecha, hora e intentos.
            </span>
          </p>

          <div class="actions">
            <button type="submit">Enviar enlace</button>
            <a href="/" class="cancel">Cancelar</a>
          </div>
        </form>

        <div id="message" class="message"></div>
      </section>
    </div>
  </div>

  <style is:global>
    .access-note {
      text-align: center;
      max-width: 100%;
    }

    .access-note-nowrap {
      white-space: nowrap;
    }

    @media (max-width: 620px) {
      .access-note-nowrap {
        white-space: normal;
      }
    }
    
    .access-wrapper {
      min-height: 100vh;
    }

    .access-overlay {
      background:
        rgba(0, 0, 0, 0.45),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.45));
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .access-main {
      min-height: 100vh;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .access-card {
      width: min(92vw, 440px);
      background: rgba(5, 5, 5, 0.88);
      border-radius: 1.25rem;
      padding: 2rem 1.6rem 1.5rem;
      box-shadow: 0 25px 80px rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      color: #fff;
    }

    .card-enter {
      animation: modalIn 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform: translateY(14px) scale(0.985);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .access-card h1 {
      margin: 0 0 0.5rem;
      font-size: 2rem;
      color: #fff;
    }

    .access-url {
      margin: 0 0 1.5rem;
      font-size: 0.95rem;
      color: #f1f1f1;
    }

    .field {
      margin-bottom: 1rem;
    }

    .field label {
      display: block;
      margin-bottom: 0.5rem;
      color: #fff;
      font-size: 0.95rem;
    }

    .field input {
      width: 100%;
      height: 3.2rem;
      border-radius: 0.9rem;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(43, 56, 81, 0.72);
      color: #fff;
      padding: 0 1rem;
      font-size: 1rem;
      outline: none;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }

    .field input:focus {
      border-color: #c6cfb3;
      box-shadow: 0 0 0 3px rgba(198, 207, 179, 0.12);
      background: rgba(43, 56, 81, 0.9);
    }

    .access-note {
      margin: 0.25rem 0 1.15rem;
      color: #e1e1e1;
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .actions {
      display: flex;
      gap: 0.85rem;
      margin-top: 1rem;
    }

    .actions button,
    .actions .cancel {
      flex: 1;
      min-height: 3.1rem;
      border-radius: 999px;
      border: 0;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition:
        transform 0.15s ease,
        opacity 0.2s ease,
        filter 0.2s ease;
    }

    .actions button:hover,
    .actions .cancel:hover {
      transform: translateY(-1px);
      filter: brightness(1.03);
    }

    .actions button {
      background: #c6cfb3;
      color: #111;
    }

    .actions .cancel {
      background: #44503d;
      color: #fff;
    }

    .message {
      margin-top: 1rem;
      font-size: 0.95rem;
      line-height: 1.55;
      white-space: pre-wrap;
      color: #ededed;
    }

    .message a {
      color: #c6cfb3;
      text-decoration: underline;
    }

    .message.error {
      color: #ffb4b4;
    }
  </style>

  <script is:inline>
    const form = document.getElementById("access-form");
    const message = document.getElementById("message");

    function formatDateTime(dateString) {
      const date = new Date(dateString);

      return new Intl.DateTimeFormat("es-CR", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    }

    function getTtlLabel() {
      const ttl = 30; // cambia a 60 si luego usas 1 hora
      if (ttl === 60) return "1 hora";
      if (ttl === 30) return "30 minutos";
      return `${ttl} minutos`;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      message.className = "message";
      message.textContent = "Procesando solicitud...";

      const formData = new FormData(form);

      const payload = {
        email: formData.get("email"),
        company: formData.get("company"),
      };

      try {
        const response = await fetch("/api/access/request", {
          method: "POST",
          headers: {
            "content-type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json();

        if (!response.ok) {
          message.className = "message error";
          message.textContent =
            data.error || "No se pudo procesar la solicitud.";
          return;
        }

        const prettyDate = formatDateTime(data.expiresAt);
        const ttlLabel = getTtlLabel();

        message.className = "message";

        if (data.previewUrl) {
          message.innerHTML = `
            Solicitud procesada correctamente.

            El enlace de acceso fue enviado.
            Tiempo de validez: ${ttlLabel}
            Disponible hasta: ${prettyDate}

            Correo de prueba local:
            <a href="${data.previewUrl}" target="_blank" rel="noreferrer">Abrir email de prueba</a>
            `;
          return;
        }

        message.textContent = `Se envió el enlace temporal. Duración: ${ttlLabel}. Válido hasta: ${prettyDate}`;
      } catch (error) {
        message.className = "message error";
        message.textContent = "Error de red al solicitar el acceso.";
      }
    });
  </script>
</BaseLayout>
