---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Andrés Hidalgo">
  <div id="wrapper">
    <div id="bg"></div>
    <div id="overlay"></div>
    <div id="main">
      <header id="header">
        <h1>Andrés Hidalgo</h1>
        <h2>Systems Engineering • CyberSecurity Analyst • IT Geek</h2>
        <nav>
          <ul>
            <li>
              <a href="https://andreshidalgo.com" class="icon fa-sitemap">
                <span class="label">WebSite</span>
              </a>
            </li>
            <li>
              <a href="/CVENG.pdf" download class="icon fa-file-pdf-o">
                <span class="label">Curriculum</span>
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/in/andr%C3%A9shidalgo"
                class="icon fa-linkedin"
              >
                <span class="label">LinkedIn</span>
              </a>
            </li>
            <li>
              <a
                href="https://www.github.com/andresisho"
                class="icon fa-github-square"
              >
                <span class="label">GitHub</span>
              </a>
            </li>
          </ul>
        </nav>
      </header>

      <footer id="footer">
        <span class="copyright">&copy; Derechos Reservados.</span>
      </footer>
    </div>
  </div>
</BaseLayout>
